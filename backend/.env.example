# Neon Postgres — get both from your Neon project's connection details page.
# DATABASE_URL: the pooled connection (has "-pooler" in the host), used at runtime.
# DIRECT_URL: the unpooled connection, used only for migrations.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/order_management?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/order_management?sslmode=require"

# Comma-separated list of allowed frontend origins (e.g. your Vercel URL)
CORS_ORIGIN="http://localhost:5173"

# Used by local dev only (api/index.ts on Vercel doesn't need this)
PORT=4000
